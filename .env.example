# Jev / OpenJev backend config
# copy to .env and fill one of the keys

# Hosted Jev (TypeSafe) — preferred for prod
TYPESAFE_API_KEY=ts_...

# OR OpenRouter gateway
# OPENROUTER_API_KEY=...

# OR Vercel AI Gateway
# AI_GATEWAY_API_KEY=...

# OR self-hosted OpenJev / mock
# JEV_BACKEND=mock
# JEV_BACKEND=openjev-local
# JEV_BACKEND=custom
# JEV_BASE_URL=https://your-openjev.example.com/v1/systemone
# JEV_API_KEY=...

# Optional
# JEV_MODEL=jev-latest

# ---- LLM baseline (only for `node bench/eval.mjs` head-to-head) ----
# Any OpenAI-compatible endpoint. Set MODEL + KEY to enable the comparison.
# BASELINE_MODEL=gpt-4o-mini
# BASELINE_API_KEY=sk-...
# BASELINE_BASE_URL=https://api.openai.com/v1
# BASELINE_SAMPLES=1        # >1 = self-consistency (samples k times)
# BASELINE_TEMPERATURE=0
# BASELINE_HEADERS={"x-opencode-session":"ses_..."}   # extra headers, e.g. OpenCode Zen Go
# BASELINE_PRICE_IN=0.15    # $/M input tokens (for the $/1k column)
# BASELINE_PRICE_OUT=0.60   # $/M output tokens
# JEV_PRICE_IN=0.042        # Jev $/M input tokens (output is free)
